# Copy this file to .env and fill in your real values.
# .env itself should NEVER be committed - only .env.example goes in git.

SPLUNK_HOST=192.168.18.210
SPLUNK_PORT=8089
SPLUNK_USER=admin
SPLUNK_PASS=your_password_here

# SSL Certificate Verification (default: true)
# Set to 'false' ONLY in lab/development environments utilizing self-signed SSL certificates.
SPLUNK_VERIFY_SSL=false
